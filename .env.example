DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=rentwise

# Module 7: session cookie signing key. Generate a real random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app runs with a fallback dev key if this is missing, but ALWAYS
# set a real one before deploying anywhere real — it's what stops
# someone from forging a session cookie for another user.
SESSION_SECRET_KEY=change_this_to_a_random_string

# Module 4: AI Property Finder
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.1-flash-lite
